# Historical simulator copies, downloads and archived run outputs (local only).
/archive/*
!/archive/docs/
!/archive/reorganization-20261022.json

# Large generated experiment trees (local only).
/results/*
/simulators/sue/harness/validation/
/simulators/sue/harness/v2/validation/
/simulators/sue/harness/build-logs/
**/runs/

# Build products and caches. Do not ignore ns-3 build-support/ sources.
build/
cmake-cache/
CMakeFiles/
CMakeCache.txt
__pycache__/
*.py[cod]
.venv/
venv/
node_modules/
*.o
*.obj
*.so
*.so.*
*.a
*.dylib
*.pcap
*.pcapng
*.log

# Rebuildable bundles and backup archives; retain report HTML and figures.
*.zip
*.tar
*.tar.gz
*.tgz
*.tar.bz2
*.tar.xz
*.7z

# Machine-local settings and credentials.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa
id_ed25519
.DS_Store
*.swp
*.swo

# Local report hosting and public tunnel operations.
/ops/

# Downloaded related work: third-party papers and source checkouts.
# Local paper toolchain and generated build intermediates.
/isca2026/transaction-aware/.tools/
/isca2026/transaction-aware/.cache/
/isca2026/transaction-aware/build/
/isca2026/transaction-aware/vendor/*.zip

# Local reference PDFs, extracted text, and literature notes.
/isca2026/transaction-aware/ref/

# Superseded generated reports and local literature copies.
/docs/reports/hm-emu/archive*/
/isca2026/*/ref/
/isca2026/*/.tools/
/isca2026/*/.cache/
/isca2026/*/build/
